{
  "name": "mosaics-world",
  "private": true,
  "version": "0.4.0",
  "description": "The Mosaics' world: a living isometric stick-figure simulation (MosaicScope easter egg).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:touch": "node e2e/touch.mjs",
    "bench": "vite-node scripts/bench.ts",
    "catalogue": "vite-node scripts/catalogue.ts",
    "smoke": "node e2e/smoke.mjs",
    "soak": "vite-node scripts/soak.ts",
    "terrance": "vite-node scripts/terrance-feed.ts",
    "critique": "vite-node scripts/critique.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "^1.56.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^2.1.4"
  }
}
